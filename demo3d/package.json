{
  "name": "beliefview-demo3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Illustrative, deterministic 3D drone search simulation (separate from the frozen BeliefView v2 2D experiment).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/smoke.mjs",
    "ml:gen": "tsx tools/gen_episodes.ts",
    "ml:eval": "tsx tools/eval_closed_loop.ts"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "playwright-core": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
